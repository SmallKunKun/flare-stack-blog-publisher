{
  "name": "flare-stack-blog-publisher",
  "version": "0.2.0",
  "description": "Publish notes from Obsidian to Flare Stack Blog",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmallKunKun/flare-stack-blog-publisher.git"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "install:plugin": "node scripts/install.mjs",
    "link:plugin": "node scripts/install.mjs --link"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "flare-stack-blog",
    "blog"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.7",
    "typescript": "^5.7.2"
  }
}
